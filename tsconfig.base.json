{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@ai-workflow-utils/shared-types": ["./libs/shared-types/src/index.ts"],
      "@ai-workflow-utils/data": ["./libs/data/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
