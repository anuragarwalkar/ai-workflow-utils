{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config apps/ui/vite.config.ts"
      },
      "outputs": ["{workspaceRoot}/dist/apps/ui"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/ui/vite.config.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config apps/ui/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/ui/tsconfig.json --noEmit"
      }
    }
  }
}
